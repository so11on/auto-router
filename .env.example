# auto-router settings. `node ar.mjs init` copies this to .env and fills the secrets that can be generated.
# Never commit .env. Reference: docs/CONFIGURATION.md

# --- gateway (LiteLLM) ---
# Bearer token that clients (VS Code) use against the gateway on :4000. Generated by init.
LITELLM_MASTER_KEY=
ROUTING_FILE=/app/ar/routing.yaml
# Model used to classify each request (task + complexity). A LiteLLM model string, or "pool" to use the free pool.
CLASSIFIER_MODEL=gemini/gemini-3.5-flash-lite
# Append "which model answered" to every final answer.
AUTO_ROUTER_FOOTER=true

# --- Gemini: two different keys on purpose ---
# Key from a Google project WITH billing (paid models and the classifier). Leave empty if you have none.
GEMINI_API_KEY=
# Key from a Google project WITHOUT billing (free tier, last-resort fallback of auto-free).
GEMINI_FREE_API_KEY=

# --- Claude ---
# Anthropic API key (needs account credits). Only for the "api" route.
ANTHROPIC_API_KEY=
# cli = Claude Code on this computer with your own login (needs the `claude` CLI); api = Anthropic API key.
CLAUDE_PRIMARY=cli

# --- OpenAI ---
# OpenAI API key (platform.openai.com; billed separately — a ChatGPT Plus/Pro plan does NOT include API credits). Only for the "api" route.
OPENAI_API_KEY=
# cli = Codex CLI signed in with your ChatGPT Plus/Pro account (runs on this computer); api = OpenAI API key.
OPENAI_PRIMARY=cli
# Codex model ids for the cli route (empty = Codex's own default model). Written by `node ar.mjs openai`.
CODEX_MODEL_MINI=
CODEX_MODEL_MAIN=
CODEX_MODEL_MAX=

# --- GitHub Copilot (paid plan) through the Copilot CLI ---
# Model ids for the Copilot CLI (empty = its default model). Written by `node ar.mjs copilot`.
COPILOT_MODEL_MINI=
COPILOT_MODEL_MAIN=
COPILOT_MODEL_MAX=

# --- claude-bridge (runs on this computer, not in Docker) ---
# Required bearer for the bridge. Generated by init.
BRIDGE_KEY=
# Comma-separated folders Claude Code may edit. Set by init.
BRIDGE_ALLOWED_ROOTS=

# --- free pool (OmniRoute) ---
FREE_POOL_BASE=http://omniroute:20128/v1
# OmniRoute API key. Created by `node ar.mjs omniroute`.
FREE_POOL_KEY=
# Becomes true when `node ar.mjs omniroute` has built working combos.
FREE_POOL_ENABLED=false
# OmniRoute dashboard password. Generated by init.
OMNIROUTE_PASSWORD=

# --- free provider keys (registered in OmniRoute by `node ar.mjs omniroute`) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
NVIDIA_API_KEY=
# Cloudflare Workers AI: both come from the same dashboard page (see docs/GET-KEYS.md).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- safety (see docs/SECURITY.md) ---
# on (default): models classed "unsafe" (may log or train on prompts) are removed from every route. off: allow them.
SAFETY_MODE=on
# on (default): prompts holding secrets or personal data are masked and only go to the classes below.
SENSITIVE_GUARD=on
# Classes allowed to receive sensitive content (comma separated). trusted | no_retention. "restricted" and "unsafe" are never accepted.
SENSITIVE_ALLOWED_CLASSES=trusted
# Replace detected secrets by placeholders before any model sees them.
SENSITIVE_MASK_SECRETS=on
# Also replace personal data (CPF, e-mail, phone, card). Off: personal data stays but the request is routed as sensitive.
SENSITIVE_MASK_PII=off
# trusted_only: a request with an image is treated as sensitive (images cannot be scanned).
SENSITIVE_IMAGES=trusted_only
# closed: if the scanner fails, treat the request as sensitive. open: ignore the failure.
DLP_FAIL_MODE=closed

# Address the bridge listens on. Keep 127.0.0.1 (0.0.0.0 and :: are refused). Linux + Docker: use the docker0 address.
# BRIDGE_HOST=127.0.0.1

# Free-pool circuit breaker: after POOL_FAIL_THRESHOLD failures within POOL_FAIL_WINDOW_S seconds the pool is skipped for POOL_COOLDOWN_S seconds.
POOL_FAIL_THRESHOLD=3
POOL_FAIL_WINDOW_S=60
POOL_COOLDOWN_S=300
